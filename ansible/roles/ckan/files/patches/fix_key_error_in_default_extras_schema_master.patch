From 352870725aecbd836c09eed4f9f11ca840127326 Mon Sep 17 00:00:00 2001
From: Stefanie Taepke <stefina@users.noreply.github.com>
Date: Thu, 10 Sep 2026 14:19:29 +0200
Subject: [PATCH 2/2] fix: add regression test for ignore_not_sysadmin KeyError

default_extras_schema()'s 'id' field is seeded with the `missing` sentinel by augment_data() before the main validation happens, since the extras row is only known from the data, not yet flattened. But a sibling field using convert_from_extras (e.g. ckanext-showcase's author, author_email, showcase_type, ...) is a shorter, and thus earlier-sorted, key than ('extras', 0, 'id'). When it consumes its matching extras row it deletes that row's 'id'/'key'/'value' subkeys, so by the time the loop reaches ('extras', 0, 'id') the key is gone.
---
 ckan/tests/logic/test_conversion.py | 20 +++++++++++++++++++-
 1 file changed, 19 insertions(+), 1 deletion(-)

diff --git a/ckan/tests/logic/test_conversion.py b/ckan/tests/logic/test_conversion.py
index 8bdba63993..b031373dde 100644
--- a/ckan/tests/logic/test_conversion.py
+++ b/ckan/tests/logic/test_conversion.py
@@ -4,7 +4,8 @@
 """
 from ckan import model
 from ckan.lib.navl.dictization_functions import validate
-from ckan.logic.converters import convert_to_extras
+from ckan.lib.navl.validators import not_empty
+from ckan.logic.converters import convert_from_extras, convert_to_extras
 from ckan.logic.schema import default_extras_schema
 
 
@@ -138,3 +139,20 @@ def test_convert_to_extras_free_extra_can_not_have_the_same_key():
     assert errors["extras"] == [
         {"key": [u"There is a schema field with the same name"]}
     ]
+
+
+def test_convert_from_extras_does_not_crash_when_extras_row_has_no_id():
+
+    data_dict = {"extras": [{"key": "custom_text", "value": "Hi"}]}
+
+    schema = {
+        "custom_text": [convert_from_extras, not_empty],
+        "extras": default_extras_schema(),
+    }
+
+    context = {"model": model, "session": model.Session}
+
+    data, errors = validate(data_dict, schema, context)
+
+    assert data["custom_text"] == "Hi"
+    assert errors == {"extras": [{"key": [u"Missing value"]}]}

